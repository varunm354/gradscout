# GradScout secrets — copy to .env for local use, or set as GitHub Actions secrets.
# Secrets come ONLY from environment variables. Never commit real values.

# Required for sending Discord alerts (dry-run mode does not need this).
DISCORD_WEBHOOK_URL=

# Optional: only used by the bounded LLM enrichment agent (Phase 3-4).
# If unset, GradScout runs fully with deterministic rules only.
OPENAI_API_KEY=
GRADSCOUT_LLM_MODEL=gpt-4o-mini
